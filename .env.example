# Copy to .env and fill in. The default `local` profile needs NONE of these.
#
#   cp .env.example .env

# Which provider backend to use: "local" (default, no keys, offline) or "cloud".
RAG_PROFILE=local

# ---- local profile ----------------------------------------------------------
# Ollama must be running for generation on the local profile.
#   ollama serve && ollama pull qwen2.5:1.5b
OLLAMA_HOST=http://localhost:11434
LOCAL_GENERATION_MODEL=qwen2.5:1.5b
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- cloud profile ----------------------------------------------------------
# Generation via Claude. Anthropic has no embeddings endpoint — those come from Voyage.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Model IDs are overridable so you are never blocked by a stale default.
CLOUD_GENERATION_MODEL=claude-opus-5
CLOUD_CHEAP_MODEL=claude-haiku-4-5
CLOUD_EMBEDDING_MODEL=voyage-3-large
CLOUD_RERANK_MODEL=rerank-2.5

# ---- storage ----------------------------------------------------------------
VECTOR_STORE=chroma
CHROMA_PATH=.chroma
